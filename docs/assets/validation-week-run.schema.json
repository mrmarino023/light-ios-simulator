{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligh.dev/schemas/validation-week-run-v2.json",
  "title": "ValidationWeekRunV2",
  "type": "object",
  "required": [
    "schema_version",
    "app",
    "task",
    "arm",
    "protocol",
    "protocol_version",
    "prompt_hash",
    "git_sha",
    "wall_time_ms",
    "llm_tokens",
    "pass",
    "diagnosis_class",
    "run_id",
    "repeat_index",
    "kind",
    "failure_phase",
    "artifact_origin",
    "raw_artifact",
    "raw_artifact_sha256",
    "scored_eligible"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "app": { "type": ["string", "null"] },
    "task": { "type": "string" },
    "arm": { "type": "string", "enum": ["autopilot", "baseline", "ligh", "hybrid"] },
    "model": { "type": ["string", "null"] },
    "protocol": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": "integer", "minimum": 1 },
    "prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git_sha": { "type": "string" },
    "wall_time_ms": { "type": ["number", "null"] },
    "llm_tokens": { "type": ["number", "null"] },
    "pass": { "type": "boolean" },
    "diagnosis_class": {
      "type": "string",
      "enum": [
        "ok",
        "planner_wrong_path",
        "perception_mislabeled",
        "async_state",
        "harness_wrong",
        "source_fix_wrong",
        "infra_flake",
        "unclassified"
      ]
    },
    "patches": { "type": ["number", "null"] },
    "builds": { "type": ["number", "null"] },
    "run_id": { "type": "string" },
    "repeat_index": { "type": "integer", "minimum": 1 },
    "kind": { "type": "string", "enum": ["bugfix", "navigation", "recovery"] },
    "false_success": { "type": "boolean" },
    "verification_reason": { "type": ["string", "null"] },
    "failure_phase": {
      "type": ["string", "null"],
      "enum": [null, "bootstrap", "setup", "precondition", "exercise", "postcondition", "agent", "protocol", "infra", "unknown"]
    },
    "historical": { "type": "boolean" },
    "source": { "type": "string" },
    "artifact_origin": { "const": "raw_per_run" },
    "raw_artifact": { "type": "string", "minLength": 1 },
    "raw_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scored_eligible": { "type": "boolean" },
    "protocol_violations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
