  "agent_prompt": "The Kix sneaker store login is broken \u2014 after signing in with valid credentials the user never reaches the authenticated Home tab. Find and fix the issue in the Swift source under fixtures/third-party/Kix/, rebuild the app, exercise login in the Simulator, and verify. Known good credentials: email test@kixapp.com, password password. Success = Home tab visible (tab_home / Home) after Sign In.",
  "source_root": "fixtures/third-party/Kix/Kix",
  "build_script": "scripts/build-kix.sh",
  "app_path": "fixtures/third-party/Kix/build/Kix.app",
  "bundle_id": "mybyKosta.Kix",
  "bug_patch": "fixtures/third-party/Kix/scenarios/login-never-authenticates.patch",
  "bootstrap_wait_label": "Welcome Back",
  "initial_state": "broken",
  "verification": {
    "initial_setup": [],
    "preconditions": {
      "must_see_labels": [
        "Welcome Back",
        "SIGN IN"
      ],
      "must_not_see_labels": [
        "tab_home",
        "Home"
      ]
    },
    "exercise": [
      {
        "action": "type",
        "id": "login_email_field",
        "text": "test@kixapp.com",
        "settle_ms": 1500
      },
      {
        "action": "type",
        "id": "login_password_field",
        "text": "password",
        "settle_ms": 1500
      },
      {
        "action": "tap",
        "id": "login_button",
        "label": "SIGN IN",
        "settle_ms": 3500
      }
    ],
    "postconditions": {
      "must_see_labels": [
        "tab_home",
        "Home"
      ],
      "must_not_see_labels": [
        "login_button"
      ]
    },
    "onboarding_overlay_labels": []
  },
  "legacy_weak_success_labels": [
    "tab_home"
  ],
  "run_goal_params": [
    {
      "value": "test@kixapp.com"
    },
    {
      "value": "password",
      "secure": true
    }
