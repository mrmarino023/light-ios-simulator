  "agent_prompt": "Kix Notes Add is broken \u2014 typing a note and tapping Add does not keep the note on screen. Find and fix the issue under fixtures/third-party/Kix/, rebuild, exercise login \u2192 Notes \u2192 add note text 'ligh-note', and verify. Credentials: email test@kixapp.com, password password. Success = the note text 'ligh-note' is visible and the empty state is gone.",
  "source_root": "fixtures/third-party/Kix/Kix",
  "build_script": "scripts/build-kix.sh",
  "app_path": "fixtures/third-party/Kix/build/Kix.app",
  "bundle_id": "mybyKosta.Kix",
  "bug_patch": "fixtures/third-party/Kix/scenarios/notes-add-noop.patch",
  "bootstrap_wait_label": "Welcome Back",
  "initial_state": "broken",
  "verification": {
    "initial_setup": [],
    "preconditions": {
      "must_see_labels": [
        "Welcome Back",
        "SIGN IN"
      ],
      "must_not_see_labels": [
        "ligh-note"
      ]
    },
    "exercise": [
      {
        "action": "type",
        "id": "login_email_field",
        "text": "test@kixapp.com",
        "settle_ms": 1500
      },
      {
        "action": "type",
        "id": "login_password_field",
        "text": "password",
        "settle_ms": 1500
      },
      {
        "action": "tap",
        "id": "login_button",
        "label": "SIGN IN",
        "settle_ms": 3500
      },
      {
        "action": "tap",
        "label": "Notes",
        "settle_ms": 2500
      },
      {
        "action": "type",
        "id": "notes_input_field",
        "text": "ligh-note",
        "settle_ms": 1500
      },
      {
        "action": "tap",
        "id": "notes_add_update_button",
        "label": "Add",
        "settle_ms": 2500
      }
    ],
    "postconditions": {
      "must_see_labels": [
        "ligh-note",
        "notes_title"
      ],
      "must_not_see_labels": [
