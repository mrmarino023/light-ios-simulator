{
  "gate": "external_apps",
  "claim": "Apps we do not author and do not modify. Failures are signal — publish them.",
  "rules": [
    "No app source edits in this gate",
    "Workflows use accessibility ids from upstream or ligh_observe discovery",
    "Pass rate is the metric — not latency"
  ],
  "apps": [
    {
      "id": "xcuitestdemo",
      "label": "XCUITestDemo (OSS)",
      "source": "https://github.com/himalimarasinghe/XCUITestDemo",
      "bundle_id": "com.himali.XCUITestDemo",
      "build": "./scripts/build-xcuitestdemo.sh",
      "frozen": true,
      "workflows": [
        {
          "id": "login",
          "skill": "form login",
          "steps": [
            {"op": "wait", "id": "usernameTextField"},
            {"op": "tap", "id": "usernameTextField"},
            {"op": "type", "text": "alice"},
            {"op": "tap", "id": "passwordSecureField"},
            {"op": "type", "text": "secret"},
            {"op": "dismiss_overlay"},
            {"op": "tap", "id": "loginButton"},
            {"op": "wait", "id": "homeTitle"}
          ]
        }
      ]
    },
    {
      "id": "kix",
      "label": "Kix (OSS catalog / tabs)",
      "source": "https://github.com/byKosta/Kix-app",
      "bundle_id": "mybyKosta.Kix",
      "build": "./scripts/build-kix.sh",
      "frozen": true,
      "workflows": [
        {
          "id": "login_home",
          "skill": "catalog auth then home tab",
          "steps": [
            {"op": "wait", "id": "login_email_field"},
            {"op": "tap", "id": "login_email_field"},
            {"op": "type", "text": "test@kixapp.com"},
            {"op": "tap", "id": "login_password_field"},
            {"op": "type", "text": "password"},
            {"op": "dismiss_overlay"},
            {"op": "tap", "id": "login_button"},
            {"op": "wait", "id": "tab_home"}
          ]
        }
      ]
    }
  ]
}
