# Copy to ~/.ligh/wda.env — loaded by lighd for physical arms (WDA).
# UDID: xcrun xctrace list devices   OR   Xcode → Window → Devices
LIGH_WDA_UDID=YOUR_IPHONE_UDID
LIGH_WDA_BUNDLE=com.example.YourApp
LIGH_WDA_XCODE_ORG_ID=YOUR_TEAM_ID
LIGH_WDA_XCODE_SIGNING_ID=Apple Development
LIGH_WDA_URL=http://127.0.0.1:4723
# Optional: reuse an existing Appium session id
# LIGH_WDA_SESSION=
